# ==============================================================================
# DevScrolls Blog Automation Platform — Environment Configuration
# Copy this file to .env and populate your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# App Environment
# ------------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
INTERNAL_API_SECRET=your-internal-worker-secret-token
BASE_BLOG_URL=https://devscrolls.dev

# ------------------------------------------------------------------------------
# Pluggable AI Model Configuration
# ------------------------------------------------------------------------------
# DEFAULT_AI_PROVIDER: 'gemini' (Zero-Cost Free Tier) or 'anthropic' (Claude)
DEFAULT_AI_PROVIDER=gemini

# Optional: Override individual agents to mix models (e.g. Gemini for analysis, Claude for writer)
# ANALYST_AI_PROVIDER=gemini
# RESEARCH_AI_PROVIDER=gemini
# FACTCHECK_AI_PROVIDER=gemini
# WRITER_AI_PROVIDER=gemini

# --- Google Gemini Settings (Free Tier Default) ---
GEMINI_API_KEY=your-gemini-api-key-from-aistudio
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-flash-lite

# --- Anthropic Claude Settings (For future upgrade when ready) ---
ANTHROPIC_API_KEY=your-anthropic-api-key-optional
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ------------------------------------------------------------------------------
# Telegram Bot Configuration
# ------------------------------------------------------------------------------
# Get your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
# Generate a random secret for X-Telegram-Bot-Api-Secret-Token validation
TELEGRAM_WEBHOOK_SECRET=your-random-webhook-secret-token
# Comma-separated list of numeric Telegram User IDs authorized to interact with the bot
AUTHORIZED_TELEGRAM_USER_IDS=123456789

# ------------------------------------------------------------------------------
# Supabase Database Configuration
# ------------------------------------------------------------------------------
# From Supabase Dashboard -> Project Settings -> API
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# CRITICAL: Use the Service Role Key (secret), NOT the public anon key!
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# Tavily Web Research Configuration
# ------------------------------------------------------------------------------
# From https://app.tavily.com (Free plan: 1,000 search credits/month)
TAVILY_API_KEY=tvly-your-tavily-api-key

# ------------------------------------------------------------------------------
# GitHub Publishing Configuration
# ------------------------------------------------------------------------------
# GitHub Fine-Grained Personal Access Token with 'Contents: Read and Write' on target repo
GITHUB_TOKEN=github_pat_your-token-here
GITHUB_REPO_OWNER=santhanakrishnanstark
GITHUB_REPO_NAME=myblog
GITHUB_BRANCH=main

# ------------------------------------------------------------------------------
# Kit (ConvertKit) Newsletter Configuration (Optional)
# ------------------------------------------------------------------------------
# From https://app.kit.com/account_settings/developer
KIT_API_KEY=
KIT_API_SECRET=


