---
export interface Props {
  type?: 'note' | 'tip' | 'warning' | 'danger';
  title?: string;
}

const { type = 'note', title } = Astro.props;

const config = {
  note: {
    icon: 'ℹ️',
    colorVar: 'var(--state-info)',
    bgVar: 'rgba(59, 130, 246, 0.1)',
    defaultTitle: 'Note'
  },
  tip: {
    icon: '💡',
    colorVar: 'var(--state-success)',
    bgVar: 'rgba(34, 197, 94, 0.1)',
    defaultTitle: 'Tip'
  },
  warning: {
    icon: '⚠️',
    colorVar: 'var(--state-warning)',
    bgVar: 'rgba(234, 179, 8, 0.1)',
    defaultTitle: 'Warning'
  },
  danger: {
    icon: '🚨',
    colorVar: 'var(--state-error)',
    bgVar: 'rgba(239, 68, 68, 0.1)',
    defaultTitle: 'Danger'
  }
};

const { icon, colorVar, bgVar, defaultTitle } = config[type];
const displayTitle = title || defaultTitle;
---
<aside class={`callout callout-${type}`}>
  <div class="callout-header">
    <span class="callout-icon" aria-hidden="true">{icon}</span>
    <strong class="callout-title">{displayTitle}</strong>
  </div>
  <div class="callout-body">
    <slot />
  </div>
</aside>

<style define:vars={{ colorVar, bgVar }}>
  .callout {
    background-color: var(--bgVar);
    border-left: 4px solid var(--colorVar);
    padding: var(--space-4) var(--space-6);
    border-radius: 0 8px 8px 0;
    margin: var(--space-6) 0;
  }
  .callout-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }
  .callout-title {
    color: var(--text-primary);
    font-weight: 600;
  }
  .callout-body {
    color: var(--text-secondary);
    font-size: var(--text-body);
  }
  
  /* Reset prose margins inside callouts */
  .callout-body :global(> *:first-child) {
    margin-top: 0;
  }
  .callout-body :global(> *:last-child) {
    margin-bottom: 0;
  }
</style>
