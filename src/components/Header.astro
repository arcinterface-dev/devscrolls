---
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname;
const isGamesActive = currentPath.startsWith('/games') || currentPath.startsWith('/arcade');
const isToolsActive = currentPath.startsWith('/tools') || currentPath.startsWith('/ats-checker');
---

<header class="site-header" id="site-header">
  <div class="header-container">
    <a href="/" class="logo" aria-label="DevScrolls Home">
      <svg class="logo-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <!-- Left Roller Handle -->
        <path d="M4 2v20M2 4h4M2 20h4" />
        <!-- Right Roller Handle -->
        <path d="M20 2v20M18 4h4M18 20h4" />
        <!-- Rolled Paper Page -->
        <path d="M4 6c4-1 12-1 16 0" />
        <path d="M4 18c4 1 12 1 16 0" />
        <!-- Coding </> inside -->
        <path d="M8.5 9.5L6 12l2.5 2.5" />
        <path d="M15.5 9.5l2.5 2.5-2.5 2.5" />
        <path d="M13 8.5l-2 7" />
      </svg>
      <span>DevScrolls</span>
    </a>
    
    <!-- Primary Product-Focused Navigation -->
    <nav class="main-nav" aria-label="Main Navigation">
      <ul class="nav-list">
        <li>
          <a 
            href="/articles/" 
            class={`nav-link ${currentPath.startsWith('/articles') ? 'active' : ''}`}
            aria-current={currentPath.startsWith('/articles') ? 'page' : undefined}
          >
            <span class="nav-label">Articles</span>
          </a>
        </li>

        <li>
          <a 
            href="/jobs/" 
            class={`nav-link ${currentPath.startsWith('/jobs') ? 'active' : ''}`}
            aria-current={currentPath.startsWith('/jobs') ? 'page' : undefined}
          >
            <span class="nav-label">Jobs</span>
          </a>
        </li>

        <li>
          <a 
            href="/games/" 
            class={`nav-link ${isGamesActive ? 'active' : ''}`}
            aria-current={isGamesActive ? 'page' : undefined}
          >
            <span class="nav-label">Games</span>
            <span class="nav-badge new">New</span>
          </a>
        </li>

        <!-- Explore Dropdown -->
        <li class="dropdown-item" id="explore-dropdown-wrapper">
          <button 
            type="button" 
            class={`nav-link dropdown-toggle ${isToolsActive ? 'active' : ''}`} 
            id="explore-btn"
            aria-expanded="false" 
            aria-haspopup="true"
          >
            <span class="nav-label">Explore</span>
            <svg class="dropdown-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>

          <!-- Rich Dropdown Menu -->
          <div class="dropdown-menu" id="explore-menu" role="menu" aria-label="Explore DevScrolls">
            <div class="dropdown-content">
              <!-- Left Column: Developer Tools -->
              <div class="dropdown-column tools-col">
                <div class="dropdown-section-header">
                  <span class="dropdown-section-title">Developer Utilities</span>
                  <a href="/tools/" class="dropdown-see-all">View all 5 tools &rarr;</a>
                </div>

                <div class="dropdown-grid">
                  <a href="/ats-checker/" class="menu-card featured" role="menuitem">
                    <div class="menu-card-icon ats-icon">📄</div>
                    <div class="menu-card-body">
                      <div class="menu-card-title-row">
                        <span class="menu-card-title">ATS Resume Checker</span>
                        <span class="menu-badge free">Free</span>
                      </div>
                      <p class="menu-card-desc">Audit parseability across Workday, Greenhouse & Lever</p>
                    </div>
                  </a>

                  <a href="/tools/pii-scrubber/" class="menu-card" role="menuitem">
                    <div class="menu-card-icon">🔒</div>
                    <div class="menu-card-body">
                      <span class="menu-card-title">PII & Secret Scrubber</span>
                      <p class="menu-card-desc">Sanitize API keys & tokens before pasting into AI</p>
                    </div>
                  </a>

                  <a href="/tools/jwt-debugger/" class="menu-card" role="menuitem">
                    <div class="menu-card-icon">🔑</div>
                    <div class="menu-card-body">
                      <span class="menu-card-title">JWT Inspector</span>
                      <p class="menu-card-desc">Verify cryptographic signatures 100% offline</p>
                    </div>
                  </a>

                  <a href="/tools/json-formatter/" class="menu-card" role="menuitem">
                    <div class="menu-card-icon">⚡</div>
                    <div class="menu-card-body">
                      <span class="menu-card-title">JSON Formatter & Diff</span>
                      <p class="menu-card-desc">Monaco-powered 5MB+ JSON editor with JSONPath</p>
                    </div>
                  </a>

                  <a href="/tools/daily-scroll/" class="menu-card" role="menuitem">
                    <div class="menu-card-icon">🎯</div>
                    <div class="menu-card-body">
                      <span class="menu-card-title">DailyScroll</span>
                      <p class="menu-card-desc">5-minute daily focus and standup companion</p>
                    </div>
                  </a>
                </div>
              </div>

              <!-- Right Column: Platform & Company -->
              <div class="dropdown-column company-col">
                <div class="dropdown-section-header">
                  <span class="dropdown-section-title">Platform</span>
                </div>

                <div class="dropdown-links-list">
                  <a href="/about/" class="company-link" role="menuitem">
                    <span class="company-link-title">About DevScrolls</span>
                    <span class="company-link-desc">Editorial standards & tech focus</span>
                  </a>

                  <a href="/contact/" class="company-link" role="menuitem">
                    <span class="company-link-title">Contact & Feedback</span>
                    <span class="company-link-desc">Inquiries, suggestions & tips</span>
                  </a>

                  <a href="/rss.xml" class="company-link" role="menuitem">
                    <span class="company-link-title">RSS Feed</span>
                    <span class="company-link-desc">Subscribe in your favorite reader</span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </li>
      </ul>
    </nav>
    
    <div class="header-controls">
      <button class="search-btn" id="search-open-btn" aria-label="Search articles" title="Search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <span class="search-label">Search</span>
      </button>
      <ThemeToggle />
      <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Menu" aria-expanded="false">
        <svg class="menu-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 12h18M3 6h18M3 18h18"/>
        </svg>
        <svg class="close-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>
  
  <!-- Mobile Nav Drawer -->
  <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile Navigation" hidden>
    <div class="mobile-nav-inner">
      <div class="mobile-section">
        <span class="mobile-section-label">Primary</span>
        <ul class="mobile-nav-list">
          <li>
            <a href="/articles/" class={`mobile-nav-link ${currentPath.startsWith('/articles') ? 'active' : ''}`}>
              Articles
            </a>
          </li>
          <li>
            <a href="/jobs/" class={`mobile-nav-link ${currentPath.startsWith('/jobs') ? 'active' : ''}`}>
              Jobs
            </a>
          </li>
          <li>
            <a href="/games/" class={`mobile-nav-link ${isGamesActive ? 'active' : ''}`}>
              <span>Games</span>
              <span class="nav-badge new">New</span>
            </a>
          </li>
        </ul>
      </div>

      <div class="mobile-section">
        <span class="mobile-section-label">Developer Tools</span>
        <ul class="mobile-nav-list">
          <li>
            <a href="/ats-checker/" class="mobile-nav-link">
              <span>ATS Resume Checker</span>
              <span class="nav-badge free">Free</span>
            </a>
          </li>
          <li>
            <a href="/tools/pii-scrubber/" class="mobile-nav-link">PII & Secret Scrubber</a>
          </li>
          <li>
            <a href="/tools/jwt-debugger/" class="mobile-nav-link">JWT Inspector</a>
          </li>
          <li>
            <a href="/tools/json-formatter/" class="mobile-nav-link">JSON Formatter & Diff</a>
          </li>
          <li>
            <a href="/tools/daily-scroll/" class="mobile-nav-link">DailyScroll Focus</a>
          </li>
          <li>
            <a href="/tools/" class="mobile-nav-link tools-all-link">All Developer Tools &rarr;</a>
          </li>
        </ul>
      </div>

      <div class="mobile-section">
        <span class="mobile-section-label">Platform</span>
        <ul class="mobile-nav-list">
          <li>
            <a href="/about/" class="mobile-nav-link">About DevScrolls</a>
          </li>
          <li>
            <a href="/contact/" class="mobile-nav-link">Contact & Feedback</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--surface-base) 88%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    transition: box-shadow 0.3s ease, border-color 0.3s ease;
    border-bottom: 1px solid var(--border-subtle);
  }
  .site-header.scrolled {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  }
  
  .header-container {
    max-width: 1140px;
    margin: 0 auto;
    padding: var(--space-3) var(--space-6);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 700;
    font-size: 1.15rem;
    text-decoration: none;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }
  .logo-icon {
    width: 22px;
    height: 22px;
    color: var(--accent-default);
    flex-shrink: 0;
  }
  
  .nav-list {
    display: flex;
    gap: var(--space-6);
    list-style: none;
    align-items: center;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    text-decoration: none;
    color: var(--text-secondary);
    font-weight: 550;
    font-size: 0.925rem;
    padding: var(--space-2) 0;
    position: relative;
    transition: color 0.15s ease;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
  }
  .nav-label {
    position: relative;
  }
  .nav-label::after {
    content: '';
    position: absolute;
    bottom: -3px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--accent-default);
    border-radius: 1px;
    transition: width 0.2s ease;
  }
  .nav-link:hover, .nav-link:focus {
    color: var(--text-primary);
  }
  .nav-link:hover .nav-label::after,
  .nav-link:focus .nav-label::after,
  .nav-link.active .nav-label::after {
    width: 100%;
  }
  .nav-link.active {
    color: var(--text-primary);
  }

  .nav-badge {
    display: inline-flex;
    align-items: center;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 1px 6px;
    border-radius: 999px;
    line-height: 1.25;
  }
  .nav-badge.new {
    background: rgba(217, 119, 6, 0.14);
    color: var(--accent-default);
    border: 1px solid rgba(217, 119, 6, 0.35);
  }
  .nav-badge.free {
    background: rgba(16, 185, 129, 0.12);
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  /* Explore Dropdown */
  .dropdown-item {
    position: relative;
  }
  .dropdown-toggle {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .dropdown-arrow {
    transition: transform 0.2s ease;
    color: var(--text-muted);
  }
  .dropdown-item:hover .dropdown-arrow,
  .dropdown-item:focus-within .dropdown-arrow {
    transform: rotate(180deg);
  }

  .dropdown-menu {
    position: absolute;
    top: calc(100% + 4px);
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1), transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.2s;
    width: 580px;
    max-width: 90vw;
    background: var(--surface-raised);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-xl);
    box-shadow: 0 16px 40px -10px rgba(0, 0, 0, 0.18), 0 0 0 1px rgba(0,0,0,0.02);
    padding: var(--space-4);
    z-index: 100;
  }

  /* Invisible hover bridge to eliminate gap between button and menu */
  .dropdown-menu::before {
    content: '';
    position: absolute;
    top: -14px;
    left: 0;
    right: 0;
    height: 14px;
    background: transparent;
  }

  /* Show menu on hover, focus, or click toggle */
  .dropdown-item:hover .dropdown-menu,
  .dropdown-item:focus-within .dropdown-menu,
  .dropdown-toggle[aria-expanded="true"] + .dropdown-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .dropdown-content {
    display: grid;
    grid-template-columns: 1.6fr 1.1fr;
    gap: var(--space-4);
  }

  .dropdown-column {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .company-col {
    border-left: 1px solid var(--border-subtle);
    padding-left: var(--space-4);
  }

  .dropdown-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--space-2) var(--space-1);
    margin-bottom: var(--space-1);
  }
  .dropdown-section-title {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }
  .dropdown-see-all {
    font-size: 11px;
    color: var(--accent-default);
    text-decoration: none;
    font-weight: 600;
    transition: opacity 0.15s;
  }
  .dropdown-see-all:hover {
    text-decoration: underline;
  }

  .dropdown-grid {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .menu-card {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 8px 10px;
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition: background 0.15s ease;
  }
  .menu-card:hover {
    background: var(--surface-sunken);
  }
  .menu-card-icon {
    font-size: 18px;
    line-height: 1;
    padding-top: 2px;
  }
  .menu-card-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .menu-card-title-row {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .menu-card-title {
    font-size: 13px;
    font-weight: 650;
    color: var(--text-primary);
  }
  .menu-badge {
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0px 5px;
    border-radius: 999px;
  }
  .menu-badge.free {
    background: rgba(16, 185, 129, 0.12);
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.3);
  }
  .menu-card-desc {
    font-size: 11.5px;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.35;
  }

  /* Company Links */
  .dropdown-links-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .company-link {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 8px 10px;
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition: background 0.15s ease;
  }
  .company-link:hover {
    background: var(--surface-sunken);
  }
  .company-link-title {
    font-size: 13px;
    font-weight: 650;
    color: var(--text-primary);
  }
  .company-link-desc {
    font-size: 11px;
    color: var(--text-muted);
  }

  /* Controls */
  .header-controls {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .search-btn {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    background: none;
    border: 1px solid var(--border-subtle);
    border-radius: 100px;
    padding: 6px var(--space-3);
    cursor: pointer;
    color: var(--text-muted);
    font-size: 13px;
    transition: all 0.2s ease;
  }
  .search-btn:hover, .search-btn:focus {
    color: var(--text-primary);
    border-color: var(--border-default);
    background: var(--surface-sunken);
  }
  .search-label {
    display: none;
  }
  @media (min-width: 640px) {
    .search-label {
      display: inline;
    }
  }
  
  .mobile-menu-btn {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-secondary);
    padding: var(--space-1);
  }
  
  /* Mobile Drawer */
  .mobile-nav {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--surface-raised);
    border-bottom: 1px solid var(--border-default);
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.1);
    padding: var(--space-4) var(--space-6) var(--space-6);
    max-height: calc(100vh - 65px);
    overflow-y: auto;
  }
  .mobile-nav[hidden] {
    display: none !important;
  }
  .mobile-nav:not([hidden]) {
    display: block;
  }
  .mobile-nav-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .mobile-section-label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin-bottom: var(--space-2);
  }
  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0;
  }
  .mobile-nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 9px var(--space-3);
    text-decoration: none;
    color: var(--text-primary);
    font-size: 14px;
    font-weight: 550;
    border-radius: var(--radius-md);
    transition: background 0.15s;
  }
  .mobile-nav-link:hover, .mobile-nav-link:focus {
    background: var(--surface-sunken);
  }
  .mobile-nav-link.active {
    color: var(--accent-default);
    background: var(--surface-sunken);
  }
  .mobile-nav-link.tools-all-link {
    color: var(--accent-default);
    font-weight: 600;
  }
  
  @media (max-width: 820px) {
    .main-nav {
      display: none;
    }
    .mobile-menu-btn {
      display: flex;
    }
  }
</style>

<script is:inline>
  // Sticky header shadow on scroll
  const header = document.getElementById('site-header');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 10) {
      header?.classList.add('scrolled');
    } else {
      header?.classList.remove('scrolled');
    }
  }, { passive: true });
  
  // Mobile menu toggle
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileNav = document.getElementById('mobile-nav');
  mobileBtn?.addEventListener('click', () => {
    const isOpen = !mobileNav?.hidden;
    mobileNav?.toggleAttribute('hidden', isOpen);
    mobileBtn?.setAttribute('aria-expanded', String(!isOpen));
    const menuIcon = mobileBtn?.querySelector('.menu-icon');
    const closeIcon = mobileBtn?.querySelector('.close-icon');
    if (menuIcon) menuIcon.style.display = isOpen ? 'block' : 'none';
    if (closeIcon) closeIcon.style.display = isOpen ? 'none' : 'block';
  });

  // Keyboard accessibility for Explore dropdown
  const exploreBtn = document.getElementById('explore-btn');
  const exploreMenu = document.getElementById('explore-menu');
  const exploreWrapper = document.getElementById('explore-dropdown-wrapper');

  exploreBtn?.addEventListener('click', (e) => {
    const isExpanded = exploreBtn.getAttribute('aria-expanded') === 'true';
    exploreBtn.setAttribute('aria-expanded', String(!isExpanded));
  });

  document.addEventListener('click', (e) => {
    if (exploreWrapper && !exploreWrapper.contains(e.target)) {
      exploreBtn?.setAttribute('aria-expanded', 'false');
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      exploreBtn?.setAttribute('aria-expanded', 'false');
      mobileNav?.setAttribute('hidden', '');
      mobileBtn?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
