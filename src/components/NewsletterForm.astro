---
/**
 * NewsletterForm.astro
 * 
 * A newsletter subscription component integrated with Kit (ConvertKit).
 * Two variants:
 *   - "inline" — compact, used at article end (narrative resolution beat)
 *   - "section" — wider, used on homepage or dedicated subscribe page
 * 
 * Configure the form URL in src/config.ts
 */
import { SITE } from '../config';

export interface Props {
  variant?: 'inline' | 'section';
}

const { variant = 'inline' } = Astro.props;
const formActionUrl = SITE.newsletter.formActionUrl;
---

<aside class={`newsletter ${variant}`} aria-label="Newsletter subscription">
  <div class="newsletter-inner">
    <div class="newsletter-text">
      {variant === 'section' ? (
        <>
          <p class="newsletter-eyebrow">Newsletter</p>
          <h2 class="newsletter-heading">Stay in the loop</h2>
          <p class="newsletter-description">
            One email a week — new articles on frontend architecture, design systems, 
            and the craft of building software. No spam, unsubscribe anytime.
          </p>
        </>
      ) : (
        <>
          <p class="newsletter-heading-inline">Enjoyed this article?</p>
          <p class="newsletter-description">
            Get a weekly email with new posts on frontend engineering and the builder's journey.
          </p>
        </>
      )}
    </div>

    <form 
      class="newsletter-form" 
      action={formActionUrl}
      method="post"
      data-kit-form
    >
      <div class="newsletter-field-group">
        <label for={`newsletter-email-${variant}`} class="sr-only">Email address</label>
        <input 
          id={`newsletter-email-${variant}`}
          type="email" 
          name="email_address" 
          placeholder="you@example.com" 
          required 
          autocomplete="email"
          class="newsletter-input"
        />
        <button type="submit" class="newsletter-button">
          <span class="button-text">Subscribe</span>
          <span class="button-loading" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M12 2v4m0 12v4m-7.07-3.93l2.83-2.83m8.48-8.48l2.83-2.83M2 12h4m12 0h4M4.93 4.93l2.83 2.83m8.48 8.48l2.83 2.83"/>
            </svg>
          </span>
        </button>
      </div>
      <p class="newsletter-success" aria-live="polite">
        Thanks — check your inbox for a confirmation link.
      </p>
      <p class="newsletter-error" aria-live="polite">
        Something went wrong. Try again, or <a href="mailto:hello@devscrolls.dev">reach out directly</a>.
      </p>
    </form>

    <p class="newsletter-privacy">
      No tracking. No spam. <a href="/privacy/">Privacy policy</a>.
    </p>
  </div>
</aside>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLFormElement>('[data-kit-form]').forEach(form => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const button = form.querySelector('.newsletter-button') as HTMLButtonElement;
        const successMsg = form.querySelector('.newsletter-success') as HTMLElement;
        const errorMsg = form.querySelector('.newsletter-error') as HTMLElement;
        const input = form.querySelector('.newsletter-input') as HTMLInputElement;

        // Reset states
        successMsg.classList.remove('visible');
        errorMsg.classList.remove('visible');
        form.classList.add('is-loading');
        button.disabled = true;

        try {
          const formData = new FormData(form);
          const response = await fetch(form.action, {
            method: 'POST',
            body: formData,
          });

          if (response.ok || response.status === 200 || response.status === 302) {
            form.classList.remove('is-loading');
            form.classList.add('is-success');
            successMsg.classList.add('visible');
            input.value = '';
          } else {
            throw new Error('Subscription failed');
          }
        } catch {
          form.classList.remove('is-loading');
          errorMsg.classList.add('visible');
          button.disabled = false;
        }
      });
    });
  });
</script>

<style>
  /* — Screen-reader only utility — */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* — Base container — */
  .newsletter {
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--space-8);
    margin-top: var(--space-12);
  }

  .newsletter-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  /* — Section variant — */
  .newsletter.section {
    border-top: none;
    padding: var(--space-12) var(--space-8);
    margin: var(--space-16) 0;
    background: var(--surface-sunken);
    border-radius: 12px;
    border: 1px solid var(--border-subtle);
  }

  .newsletter.section .newsletter-inner {
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
    align-items: center;
  }

  /* — Eyebrow — */
  .newsletter-eyebrow {
    color: var(--accent-default);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: var(--text-xs);
    margin: 0 0 var(--space-2);
  }

  /* — Headings — */
  .newsletter-heading {
    font-size: var(--text-h3);
    font-weight: 700;
    margin: 0 0 var(--space-2);
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .newsletter-heading-inline {
    font-size: var(--text-body);
    font-weight: 600;
    margin: 0 0 var(--space-1);
    color: var(--text-primary);
  }

  /* — Description — */
  .newsletter-description {
    color: var(--text-secondary);
    font-size: var(--text-small);
    line-height: var(--leading-normal);
    margin: 0;
    max-width: 48ch;
  }

  .newsletter.section .newsletter-description {
    font-size: var(--text-ui);
    max-width: 52ch;
  }

  /* — Form — */
  .newsletter-form {
    width: 100%;
    max-width: 420px;
  }

  .newsletter.section .newsletter-form {
    max-width: 440px;
  }

  .newsletter-field-group {
    display: flex;
    gap: var(--space-2);
  }

  /* — Input — */
  .newsletter-input {
    flex: 1;
    padding: var(--space-3) var(--space-4);
    background: var(--surface-raised);
    border: 1px solid var(--border-default);
    border-radius: 8px;
    color: var(--text-primary);
    font-size: var(--text-small);
    line-height: 1;
    transition: border-color 0.15s ease-out, box-shadow 0.15s ease-out;
    min-width: 0;
  }

  .newsletter-input::placeholder {
    color: var(--text-muted);
  }

  .newsletter-input:focus {
    outline: none;
    border-color: var(--border-focus);
    box-shadow: 0 0 0 3px rgba(251, 191, 36, 0.15);
  }

  /* — Button — */
  .newsletter-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-3) var(--space-6);
    background: var(--accent-default);
    color: var(--surface-base);
    border: none;
    border-radius: 8px;
    font-size: var(--text-small);
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s ease-out, transform 0.1s ease-out;
    white-space: nowrap;
    min-height: 44px;
    min-width: 44px;
  }

  .newsletter-button:hover {
    background: var(--accent-hover);
  }

  .newsletter-button:active {
    background: var(--accent-active);
    transform: scale(0.98);
  }

  .newsletter-button:focus-visible {
    outline: 2px solid var(--border-focus);
    outline-offset: 2px;
  }

  .newsletter-button:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  /* — Loading state — */
  .button-loading {
    display: none;
  }

  .is-loading .button-text {
    display: none;
  }

  .is-loading .button-loading {
    display: flex;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* — Success / Error messages — */
  .newsletter-success,
  .newsletter-error {
    display: none;
    font-size: var(--text-small);
    margin: var(--space-2) 0 0;
    line-height: var(--leading-normal);
  }

  .newsletter-success.visible {
    display: block;
    color: var(--state-success);
  }

  .newsletter-error.visible {
    display: block;
    color: var(--state-error);
  }

  .newsletter-error a {
    color: var(--state-error);
    text-decoration: underline;
  }

  /* — Success: hide the form field group — */
  .is-success .newsletter-field-group {
    display: none;
  }

  /* — Privacy line — */
  .newsletter-privacy {
    color: var(--text-muted);
    font-size: var(--text-xs);
    margin: 0;
  }

  .newsletter-privacy a {
    color: var(--text-muted);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    transition: color 0.15s;
  }

  .newsletter-privacy a:hover {
    color: var(--text-secondary);
  }

  /* — Mobile adjustments — */
  @media (max-width: 480px) {
    .newsletter-field-group {
      flex-direction: column;
    }

    .newsletter-button {
      width: 100%;
    }

    .newsletter.section {
      padding: var(--space-8) var(--space-6);
      border-radius: 8px;
    }
  }

  /* — Reduced motion — */
  @media (prefers-reduced-motion: reduce) {
    .is-loading .button-loading {
      animation: none;
    }
  }
</style>
