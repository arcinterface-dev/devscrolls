---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

export interface Props {
  title: string;
  description: string;
  gameName?: string;
  badge?: string;
}

const { title, description, gameName, badge } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLMs.txt" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="LLMs-full.txt" />
    
    <script is:inline>
      (function() {
        const getTheme = () => {
          if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
            return localStorage.getItem('theme');
          }
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        };
        const theme = getTheme();
        if (theme === 'dark') {
          document.documentElement.setAttribute('data-theme', 'dark');
        } else {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>

    <SEO title={title} description={description} />
  </head>
  <body class="arcade-body">
    <header class="arcade-minimal-header">
      <div class="arcade-header-left">
        <a href="/" class="arcade-logo" aria-label="DevScrolls Home" title="DevScrolls Home">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 2v20M2 4h4M2 20h4" />
            <path d="M20 2v20M18 4h4M18 20h4" />
            <path d="M4 6c4-1 12-1 16 0" />
            <path d="M4 18c4 1 12 1 16 0" />
            <path d="M8.5 9.5L6 12l2.5 2.5" />
            <path d="M15.5 9.5l2.5 2.5-2.5 2.5" />
            <path d="M13 8.5l-2 7" />
          </svg>
        </a>
        <span class="arcade-header-divider">/</span>
        <a href="/games/" class="arcade-nav-link">
          <span class="arcade-icon-wrap">🎮</span>
          <span class="arcade-link-text">Games</span>
        </a>
        {gameName && (
          <>
            <span class="arcade-header-divider">/</span>
            <span class="arcade-current-name">{gameName}</span>
          </>
        )}
        {badge && <span class="arcade-badge">{badge}</span>}
      </div>
      <div class="arcade-header-right">
        <a href="/arcade/" class="arcade-back-btn" title="Back to All Games">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="7" height="7" x="3" y="3" rx="1"/>
            <rect width="7" height="7" x="14" y="3" rx="1"/>
            <rect width="7" height="7" x="14" y="14" rx="1"/>
            <rect width="7" height="7" x="3" y="14" rx="1"/>
          </svg>
          <span class="arcade-back-text">Games</span>
        </a>
        <ThemeToggle />
      </div>
    </header>
    
    <main class="arcade-main">
      <slot />
    </main>
  </body>
</html>

<style>
  .arcade-body {
    display: flex;
    flex-direction: column;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    background-color: var(--surface-base);
    color: var(--text-primary);
  }

  .arcade-minimal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-2) var(--space-4);
    background: var(--surface-raised);
    border-bottom: 1px solid var(--border-subtle);
    height: 48px;
    flex-shrink: 0;
    z-index: 50;
  }

  .arcade-header-left {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-small);
    font-weight: 500;
    min-width: 0;
    overflow: hidden;
  }

  .arcade-logo {
    display: flex;
    color: var(--accent-default);
    transition: color 0.2s ease, transform 0.2s ease;
    flex-shrink: 0;
  }
  
  .arcade-logo svg {
    width: 20px;
    height: 20px;
  }

  .arcade-logo:hover {
    color: var(--accent-hover);
    transform: scale(1.05);
  }

  .arcade-header-divider {
    color: var(--border-strong);
    flex-shrink: 0;
  }

  .arcade-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
    flex-shrink: 0;
    font-weight: 600;
  }

  .arcade-icon-wrap {
    font-size: 14px;
    line-height: 1;
  }

  .arcade-nav-link:hover {
    color: var(--accent-default);
  }

  .arcade-current-name {
    color: var(--text-primary);
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 260px;
  }

  .arcade-badge {
    font-size: 11px;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--accent-default) 15%, transparent);
    color: var(--accent-default);
    border: 1px solid color-mix(in srgb, var(--accent-default) 30%, transparent);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }

  .arcade-header-right {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .arcade-back-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-muted);
    text-decoration: none;
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
    background: var(--surface-base);
    transition: all 0.2s ease;
  }

  .arcade-back-btn:hover {
    color: var(--text-primary);
    border-color: var(--accent-default);
    background: var(--surface-sunken);
  }

  @media (max-width: 640px) {
    .arcade-current-name {
      max-width: 130px;
    }
    .arcade-back-text {
      display: none;
    }
    .arcade-back-btn {
      padding: 6px;
    }
  }

  .arcade-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    position: relative;
  }

  astro-island {
    display: contents;
  }
</style>
