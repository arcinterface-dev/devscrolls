---
import BaseLayout from './BaseLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import AdSlot from '../components/AdSlot.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import TOC from '../components/TOC.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import ArticleReactions from '../components/ArticleReactions.astro';
import Comments from '../components/Comments.astro';
import SeriesNav from '../components/SeriesNav.astro';
import { SITE } from '../config';
import '../styles/prose.css';

export interface Props {
  title: string;
  description: string;
  publishDate: Date;
  updatedDate?: Date;
  category: string;
  heroImage: string;
  heroImageAlt: string;
  authorName?: string;
  readingTime?: string;
  headings?: { depth: number; slug: string; text: string }[];
  tags?: string[];
  postId?: string;
  canonical?: string;
  series?: string;
  seriesOrder?: number;
}

const { 
  title, 
  description, 
  publishDate, 
  updatedDate, 
  category, 
  heroImage, 
  heroImageAlt,
  authorName = "Santhanakrishnan",
  readingTime,
  headings = [],
  tags = [],
  postId,
  canonical,
  series,
  seriesOrder
} = Astro.props;

const formattedPublishDate = publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<BaseLayout title={title} description={description} type="article" image={heroImage} publishDate={publishDate} canonical={canonical}>
  <StructuredData 
    type="BlogPosting" 
    data={{
      headline: title,
      description: description,
      image: [new URL(heroImage, Astro.site || 'https://devscrolls.dev')],
      datePublished: publishDate.toISOString(),
      dateModified: updatedDate ? updatedDate.toISOString() : publishDate.toISOString(),
      author: [{
        "@type": "Person",
        name: authorName,
        url: Astro.site ? new URL('/about/', Astro.site) : 'https://devscrolls.dev/about/'
      }]
    }}
  />
  <StructuredData
    type="BreadcrumbList"
    data={{
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: Astro.site ? new URL('/', Astro.site) : 'https://devscrolls.dev/' },
        { "@type": "ListItem", position: 2, name: category, item: Astro.site ? new URL(`/category/${category}/`, Astro.site) : `https://devscrolls.dev/category/${category}/` },
        { "@type": "ListItem", position: 3, name: title }
      ]
    }}
  />
  
  <article class="article-container">
    <header class="article-header">
      <a href="/" class="back-link">&larr; Back to all posts</a>
      <div class="category-eyebrow">{category}</div>
      <h1 class="article-title">{title}</h1>
      
      <div class="article-meta">
        <span class="author">{authorName}</span>
        <span class="separator" aria-hidden="true">&middot;</span>
        <time datetime={publishDate.toISOString()}>{formattedPublishDate}</time>
        {readingTime && (
          <>
            <span class="separator" aria-hidden="true">&middot;</span>
            <span class="reading-time">{readingTime}</span>
          </>
        )}
      </div>
    </header>
    
    {heroImage && (
      <figure class="hero-image-container">
        <img src={heroImage} alt={heroImageAlt} class="hero-image" loading="eager" fetchpriority="high" width="960" height="540" />
      </figure>
    )}
    
    {series && postId && (
      <SeriesNav series={series} currentPostId={postId} seriesOrder={seriesOrder} />
    )}
    
    {headings && headings.length > 0 && <TOC headings={headings} />}
    
    <div class="article-content prose">
      <slot />
    </div>

    {postId && <ArticleReactions slug={postId} />}

    <AdSlot slotId={SITE.adsense.articleBottomSlotId} />
    
    <footer class="article-footer">
      <div class="author-bio">
        <img src="/profile.jpeg" alt={authorName} class="author-bio-avatar" width="56" height="56" />
        <div class="author-bio-content">
          <p class="author-bio-name">Written by <strong>{authorName}</strong></p>
          <p class="author-bio-desc">Senior Frontend Engineer & UI Architect with 7+ years of experience building scalable design systems, high-performance web architectures, and clean user experiences.</p>
          <div class="author-social-links">
            <a href={SITE.social.linkedin} target="_blank" rel="noopener noreferrer" class="bio-link">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
              <span>Connect on LinkedIn</span>
            </a>
            <a href={SITE.social.telegram} target="_blank" rel="noopener noreferrer" class="bio-link telegram">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
              <span>Join Telegram</span>
            </a>
            <a href={SITE.social.github} target="_blank" rel="noopener noreferrer" class="bio-link">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
              <span>GitHub</span>
            </a>
            <a href={SITE.social.instagram} target="_blank" rel="noopener noreferrer" class="bio-link">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
              <span>Instagram</span>
            </a>
          </div>
        </div>
      </div>
    </footer>

    <NewsletterForm variant="inline" />

    {postId && <Comments slug={postId} />}

    {postId && category && <RelatedPosts currentPostId={postId} category={category} tags={tags} />}
  </article>
</BaseLayout>

<script is:inline>
  // Copy Code Button Logic — runs after DOM is parsed
  document.querySelectorAll('.prose pre').forEach(function(block) {
    var button = document.createElement('button');
    button.className = 'copy-code-button';
    button.setAttribute('aria-label', 'Copy code to clipboard');
    button.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
    
    block.style.position = 'relative';
    block.appendChild(button);
    
    button.addEventListener('click', function() {
      var code = block.querySelector('code');
      if (!code) return;
      
      navigator.clipboard.writeText(code.innerText).then(function() {
        button.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>';
        button.classList.add('copied');
        
        setTimeout(function() {
          button.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
          button.classList.remove('copied');
        }, 2000);
      }).catch(function(err) {
        console.error('Failed to copy text: ', err);
      });
    });
  });
</script>

<style>
  .article-container {
    max-width: 720px;
    margin: 0 auto;
  }
  
  .back-link {
    display: inline-block;
    font-size: var(--text-small);
    color: var(--text-muted);
    text-decoration: none;
    margin-bottom: var(--space-8);
    transition: color 0.15s;
  }
  .back-link:hover {
    color: var(--text-primary);
  }
  
  .article-header {
    margin-bottom: var(--space-12);
  }
  .category-eyebrow {
    color: var(--accent-default);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: var(--text-xs);
    margin-bottom: var(--space-3);
  }
  .article-title {
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
  }
  .article-meta {
    color: var(--text-muted);
    font-size: var(--text-ui);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
  }
  
  .article-footer {
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: 1px solid var(--border-subtle);
  }
  .author-bio {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
  }
  .author-bio-avatar {
    border-radius: 50%;
    background: var(--surface-sunken);
    flex-shrink: 0;
    object-fit: cover;
    margin-top: var(--space-1);
  }
  .author-bio-content {
    flex: 1;
  }
  .author-bio-name {
    font-size: var(--text-ui);
    margin: 0 0 2px;
    color: var(--text-secondary);
  }
  .author-bio-name strong {
    color: var(--text-primary);
  }
  .author-bio-desc {
    color: var(--text-muted);
    font-size: var(--text-small);
    margin: 0 0 var(--space-3);
    line-height: var(--leading-normal);
  }
  .author-social-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }
  .bio-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 6px;
    background: var(--surface-raised);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    font-size: var(--text-xs);
    font-weight: 500;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .bio-link:hover {
    color: var(--text-primary);
    border-color: var(--border-default);
    transform: translateY(-1px);
  }
  .bio-link.telegram:hover {
    color: #0088cc;
    border-color: #0088cc;
  }
  
  .hero-image-container {
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: var(--space-8);
    border: 1px solid var(--border-subtle);
  }
  .hero-image {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  
  :global(.copy-code-button) {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    background: var(--surface-raised);
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    border-radius: 6px;
    padding: var(--space-2);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    opacity: 0;
  }
  :global(.prose pre:hover .copy-code-button) {
    opacity: 1;
  }
  :global(.copy-code-button:hover) {
    background: var(--surface-sunken);
    color: var(--text-primary);
    border-color: var(--border-default);
  }
  :global(.copy-code-button.copied) {
    color: var(--state-success);
    border-color: var(--state-success);
  }
</style>
