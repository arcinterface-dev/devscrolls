---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('articles', ({ data }) => !data.draft);
const recommendations = allPosts
  .sort(() => 0.5 - Math.random()) // naive shuffle
  .slice(0, 3);
---

<BaseLayout title="404: Not Found" description="The page you're looking for doesn't exist.">
  <div class="not-found-container">
    <div class="not-found-header">
      <h1 class="error-code">404</h1>
      <h2 class="error-title">We couldn't find that page</h2>
      <p class="error-description">
        The link you followed might be broken, or the page may have been removed. Let's get you back on track.
      </p>
      <a href="/" class="home-link">&larr; Back to Home</a>
    </div>
    
    {recommendations.length > 0 && (
      <div class="recommendations">
        <h3>While you're here, check out these notes:</h3>
        <div class="grid-3">
          {recommendations.map(post => (
            <Card 
              title={post.data.title}
              href={`/articles/${post.id}/`}
              description={post.data.description}
              eyebrow={post.data.category}
            />
          ))}
        </div>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .not-found-container {
    padding: var(--space-16) 0;
  }
  .not-found-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-24);
  }
  .error-code {
    font-size: 120px;
    font-weight: 800;
    color: var(--accent-default);
    line-height: 1;
    margin-bottom: var(--space-4);
  }
  .error-title {
    font-size: var(--text-h2);
    margin-bottom: var(--space-4);
  }
  .error-description {
    color: var(--text-secondary);
    font-size: var(--text-lead);
    margin-bottom: var(--space-8);
  }
  .home-link {
    display: inline-block;
    padding: var(--space-3) var(--space-6);
    background: var(--surface-raised);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    transition: background 0.2s, border-color 0.2s;
  }
  .home-link:hover, .home-link:focus {
    background: var(--surface-sunken);
    border-color: var(--border-default);
    outline: none;
  }
  .home-link:focus-visible {
    outline: 2px solid var(--border-focus);
    outline-offset: 2px;
  }
  
  .recommendations h3 {
    text-align: center;
    margin-bottom: var(--space-8);
    color: var(--text-secondary);
  }
  .grid-3 {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .grid-3 {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
