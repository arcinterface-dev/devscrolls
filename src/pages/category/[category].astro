---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StructuredData from '../../components/StructuredData.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import ArticleListItem from '../../components/ArticleListItem.astro';
import { CATEGORIES } from '../../content/_taxonomy';
import getReadingTime from 'reading-time';

export async function getStaticPaths() {
  return CATEGORIES.map(category => ({
    params: { category: category.slug },
    props: { category }
  }));
}

const { category } = Astro.props;

const allPosts = await getCollection('articles', ({ data }) => {
  return !data.draft && data.category === category.slug;
});
allPosts.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---
<BaseLayout 
  title={`${category.name} Articles — DevScrolls`} 
  description={`Browse all articles categorized under ${category.name}`}
>
  <StructuredData
    type="BreadcrumbList"
    data={{
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: Astro.site ? new URL('/', Astro.site) : 'https://devscrolls.dev/' },
        { "@type": "ListItem", position: 2, name: category.name }
      ]
    }}
  />
  <div class="category-layout">
    <header class="page-header">
      <h1 class="page-title">{category.name}</h1>
      <p class="page-subtitle">{category.description}</p>
    </header>

    <CategoryNav activeCategory={category.slug} />

    <section class="category-feed" aria-label={`Articles in ${category.name}`}>
      {allPosts.length > 0 ? (
        <div class="article-list">
          {allPosts.map((post, index) => (
            <ArticleListItem 
              title={post.data.title}
              href={`/articles/${post.id}/`}
              description={post.data.description}
              publishDate={post.data.publishDate}
              category={post.data.category}
              readingTime={getReadingTime(post.body || '').text}
              heroImage={post.data.heroImage}
              heroImageAlt={post.data.heroImageAlt}
              isFirst={index === 0}
            />
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <p>No articles published under this topic yet. Check back soon!</p>
          <a href="/articles/" class="back-home">&larr; View all articles</a>
        </div>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  .category-layout {
    max-width: 720px;
    margin: 0 auto;
  }
  .page-header {
    margin-bottom: var(--space-8);
  }
  .page-title {
    font-size: var(--text-h2);
    margin-bottom: var(--space-2);
    letter-spacing: -0.02em;
  }
  .page-subtitle {
    font-size: var(--text-ui);
    color: var(--text-muted);
    margin: 0;
  }
  .category-feed {
    display: flex;
    flex-direction: column;
  }
  .article-list {
    display: flex;
    flex-direction: column;
  }
  .empty-state {
    text-align: center;
    padding: var(--space-12) 0;
    color: var(--text-secondary);
  }
  .empty-state p {
    margin-bottom: var(--space-4);
  }
  .back-home {
    color: var(--accent-default);
    text-decoration: none;
    font-weight: 500;
  }
  .back-home:hover {
    text-decoration: underline;
  }
</style>
