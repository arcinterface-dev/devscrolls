---
if (!import.meta.env.DEV) {
  return Astro.redirect('/games/dev-skribbl/');
}
import ArcadeLayout from '../../layouts/ArcadeLayout.astro';
import { TechTiles2048 } from '../../components/arcade/TechTiles2048/TechTiles2048';

const pageTitle = "2048: Tech Evolution — DevScrolls Games";
const pageDescription = "Slide and combine computing paradigms from 1950s Punch Cards up to Quantum AGI.";
---

<ArcadeLayout
  title={pageTitle}
  description={pageDescription}
  gameName="2048: Tech Evolution"
  badge="Solo"
>
  <TechTiles2048 client:only="react" />
</ArcadeLayout>
