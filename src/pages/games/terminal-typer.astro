---
if (!import.meta.env.DEV) {
  return Astro.redirect('/games/dev-skribbl/');
}
import ArcadeLayout from '../../layouts/ArcadeLayout.astro';
import { TerminalTyper } from '../../components/arcade/TerminalTyper/TerminalTyper';

const pageTitle = "Terminal Typer — DevScrolls Games";
const pageDescription = "Test your coding syntax typing speed across TypeScript, Python, Go, Rust, and SQL with real-time WPM tracking.";
---

<ArcadeLayout
  title={pageTitle}
  description={pageDescription}
  gameName="Terminal Typer"
  badge="Solo"
>
  <TerminalTyper client:only="react" />
</ArcadeLayout>
