---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleListItem from '../components/ArticleListItem.astro';
import CategoryNav from '../components/CategoryNav.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import StructuredData from '../components/StructuredData.astro';
import { SITE } from '../config';
import { getCollection } from 'astro:content';
import getReadingTime from 'reading-time';

const allPosts = await getCollection('articles', ({ data }) => !data.draft);
allPosts.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<BaseLayout 
  title="DevScrolls — Santhanakrishnan" 
  description="Thoughts on software engineering, frontend architecture, and the builder's journey."
>
  <StructuredData 
    type="WebSite"
    data={{
      name: "DevScrolls",
      url: Astro.site ? Astro.site.toString() : 'https://devscrolls.dev',
      description: "Thoughts on software engineering, frontend architecture, and the builder's journey."
    }}
  />
  <div class="home-layout">
    <header class="home-intro">
      <div class="intro-top">
        <img src="/profile.jpeg" alt="Santhanakrishnan" class="intro-avatar" width="56" height="56" />
        <div>
          <h1 class="intro-name">DevScrolls</h1>
          <p class="intro-byline">by <strong>Santhanakrishnan</strong></p>
        </div>
      </div>
      <p class="intro-bio">
        A thoughtful builder's journal — exploring modern frontend architecture, state management, design systems, and the craft of resilient software.
      </p>
      <div class="intro-social">
        <a href={SITE.social.linkedin} target="_blank" rel="noopener noreferrer" class="intro-social-link" title="LinkedIn">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
          <span>LinkedIn</span>
        </a>
        <a href={SITE.social.telegram} target="_blank" rel="noopener noreferrer" class="intro-social-link telegram" title="Telegram Community">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
          <span>Telegram</span>
        </a>
        <a href={SITE.social.github} target="_blank" rel="noopener noreferrer" class="intro-social-link" title="GitHub">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
          <span>GitHub</span>
        </a>
        <a href={SITE.social.instagram} target="_blank" rel="noopener noreferrer" class="intro-social-link" title="Instagram">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          <span>Instagram</span>
        </a>
      </div>
    </header>

    <CategoryNav />

    <section class="home-feed" aria-label="All articles">
      {allPosts.map((post, index) => (
        <ArticleListItem 
          title={post.data.title}
          href={`/articles/${post.id}/`}
          description={post.data.description}
          publishDate={post.data.publishDate}
          category={post.data.category}
          readingTime={getReadingTime(post.body || '').text}
          heroImage={post.data.heroImage}
          heroImageAlt={post.data.heroImageAlt}
          isFirst={index === 0}
        />
      ))}
    </section>

    <NewsletterForm variant="section" />
  </div>
</BaseLayout>

<style>
  .home-layout {
    max-width: 720px;
    margin: 0 auto;
    padding: var(--space-4) 0;
  }

  .home-intro {
    margin-bottom: var(--space-12);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--border-subtle);
  }

  .intro-top {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .intro-avatar {
    border-radius: 50%;
    background: var(--surface-sunken);
    flex-shrink: 0;
    object-fit: cover;
  }

  .intro-name {
    font-size: var(--text-h3);
    margin: 0;
    letter-spacing: -0.02em;
  }

  .intro-byline {
    color: var(--text-muted);
    font-size: var(--text-small);
    margin: 0;
  }
  .intro-byline strong {
    color: var(--text-secondary);
    font-weight: 500;
  }

  .intro-bio {
    color: var(--text-secondary);
    font-size: var(--text-ui);
    line-height: var(--leading-relaxed);
    margin: 0 0 var(--space-4);
    max-width: 56ch;
  }

  .intro-social {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  .intro-social-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border-radius: 20px;
    background: var(--surface-raised);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    font-size: var(--text-xs);
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .intro-social-link:hover {
    color: var(--text-primary);
    border-color: var(--border-default);
    transform: translateY(-1px);
    background: var(--surface-sunken);
  }

  .intro-social-link.telegram:hover {
    color: #0088cc;
    border-color: #0088cc;
  }

  .home-feed {
    display: flex;
    flex-direction: column;
  }
</style>
