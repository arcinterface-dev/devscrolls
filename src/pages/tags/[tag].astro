---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StructuredData from '../../components/StructuredData.astro';
import ArticleListItem from '../../components/ArticleListItem.astro';
import { TAGS } from '../../content/_taxonomy';
import getReadingTime from 'reading-time';

export async function getStaticPaths() {
  return TAGS.map(tag => ({
    params: { tag: tag.slug },
    props: { tag }
  }));
}

const { tag } = Astro.props;

const allPosts = await getCollection('articles', ({ data }) => {
  return !data.draft && data.tags && data.tags.includes(tag.slug);
});
allPosts.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---
<BaseLayout 
  title={`${tag.name} Articles — DevScrolls`} 
  description={`Browse all articles tagged with ${tag.name}`}
>
  <StructuredData
    type="BreadcrumbList"
    data={{
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: Astro.site ? new URL('/', Astro.site) : 'https://devscrolls.dev/' },
        { "@type": "ListItem", position: 2, name: "Tags", item: Astro.site ? new URL('/tags/', Astro.site) : 'https://devscrolls.dev/tags/' },
        { "@type": "ListItem", position: 3, name: tag.name }
      ]
    }}
  />
  <div class="tag-layout">
    <header class="page-header">
      <div class="tag-eyebrow">Tagged with</div>
      <h1 class="page-title">#{tag.name}</h1>
    </header>

    <section class="tag-feed" aria-label={`Articles tagged ${tag.name}`}>
      {allPosts.length > 0 ? (
        <div class="article-list">
          {allPosts.map(post => (
            <ArticleListItem 
              title={post.data.title}
              href={`/articles/${post.id}/`}
              description={post.data.description}
              publishDate={post.data.publishDate}
              category={post.data.category}
              readingTime={getReadingTime(post.body || '').text}
              heroImage={post.data.heroImage}
              heroImageAlt={post.data.heroImageAlt}
            />
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <p>No articles tagged with #{tag.name} yet.</p>
          <a href="/tags/" class="back-home">&larr; View all tags</a>
        </div>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  .tag-layout {
    max-width: 720px;
    margin: 0 auto;
  }
  .page-header {
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--border-subtle);
  }
  .tag-eyebrow {
    color: var(--text-muted);
    font-size: var(--text-small);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-2);
  }
  .page-title {
    font-size: var(--text-h2);
    margin: 0;
    letter-spacing: -0.02em;
    color: var(--accent-default);
  }
  .tag-feed {
    display: flex;
    flex-direction: column;
  }
  .article-list {
    display: flex;
    flex-direction: column;
  }
  .empty-state {
    text-align: center;
    padding: var(--space-12) 0;
    color: var(--text-secondary);
  }
  .empty-state p {
    margin-bottom: var(--space-4);
  }
  .back-home {
    color: var(--accent-default);
    text-decoration: none;
    font-weight: 500;
  }
  .back-home:hover {
    text-decoration: underline;
  }
</style>
