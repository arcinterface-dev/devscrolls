---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StructuredData from '../../components/StructuredData.astro';

const tools = [
  {
    title: "ATS Scroll",
    description: "Free in-browser ATS resume checker. Audit your resume against Workday, Greenhouse, and Lever with instant live job matches.",
    href: "/ats-checker/",
    icon: "📄",
    isNew: true
  },
  {
    title: "PII & Secret Scrubber",
    description: "One-click regex cleaner to scrub API keys, JWTs, AWS credentials, emails, and IPs before pasting logs into AI chatbots.",
    href: "/tools/pii-scrubber/",
    icon: "🛡",
    isNew: false
  },
  {
    title: "JWT Inspector & Offline Verifier",
    description: "Client-side JWT decoding and cryptographic signature verification using native browser Web Crypto API.",
    href: "/tools/jwt-debugger/",
    icon: "🔑",
    isNew: true
  },
  {
    title: "JSON Formatter & Validator",
    description: "Format, validate, query with JSONPath, diff compare, and sort keys in a VS Code-style editor.",
    href: "/tools/json-formatter/",
    icon: "{}"
  },
  {
    title: "DailyScroll",
    description: "A frictionless daily companion for developers. Track today's work, prepare for standup.",
    href: "/tools/daily-scroll/",
    icon: "✓"
  }
];
---

<BaseLayout 
  title="Developer Tools — DevScrolls" 
  description="Client-side developer utilities designed for speed and privacy."
>
  <StructuredData 
    type="WebPage"
    data={{
      name: "Developer Tools",
      description: "Client-side developer utilities designed for speed and privacy."
    }}
  />
  <div class="tools-layout">
    <header class="tools-header">
      <h1 class="tools-title">Developer Tools</h1>
      <p class="tools-description">
        Fast, pure client-side utilities built for daily developer workflows. 
        Zero log harvesting, 100% offline-capable, and absolutely no sensitive data leaves your browser.
      </p>
    </header>

    <div class="tools-grid">
      {tools.map(tool => (
        <a href={tool.href} class="tool-card">
          <div class="tool-icon">{tool.icon}</div>
          <div class="tool-content">
            <div class="tool-name-row">
              <h2 class="tool-name">{tool.title}</h2>
              {tool.isNew && <span class="tool-badge-new">NEW</span>}
            </div>
            <p class="tool-desc">{tool.description}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .tools-layout {
    max-width: 800px;
    margin: 0 auto;
    padding: var(--space-4) 0 var(--space-16);
  }

  .tools-header {
    margin-bottom: var(--space-12);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--border-subtle);
  }

  .tools-title {
    font-size: var(--text-h2);
    margin: 0 0 var(--space-3) 0;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .tools-description {
    color: var(--text-secondary);
    font-size: var(--text-ui);
    line-height: var(--leading-relaxed);
    margin: 0;
    max-width: 60ch;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: var(--space-6);
  }

  .tool-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--surface-sunken);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .tool-card:hover {
    background: var(--surface-elevated);
    border-color: var(--border-default);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  .tool-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: var(--surface-default);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    color: var(--accent-brand);
    font-family: var(--font-mono);
    font-size: var(--text-base);
    font-weight: 700;
    flex-shrink: 0;
    transition: all 0.2s ease;
  }

  .tool-card:hover .tool-icon {
    background: var(--accent-brand);
    color: var(--surface-default);
    border-color: var(--accent-brand);
  }

  .tool-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }

  .tool-name-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .tool-badge-new {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    background: rgba(217, 119, 6, 0.15);
    color: var(--accent-brand);
    border: 1px solid rgba(217, 119, 6, 0.3);
  }

  .tool-name {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
  }

  .tool-desc {
    font-size: var(--text-small);
    color: var(--text-secondary);
    line-height: var(--leading-normal);
    margin: 0;
  }
</style>
