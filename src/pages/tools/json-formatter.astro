---
import ToolLayout from '../../layouts/ToolLayout.astro';
import StructuredData from '../../components/StructuredData.astro';
import JsonFormatter from '../../components/tools/JsonFormatter/index.tsx';
---

<ToolLayout 
  title="JSON Formatter, Validator & Diff Checker — Free Online Tool | DevScrolls" 
  description="Free online JSON formatter, validator, and diff checker with a VS Code-style editor. Beautify, minify, compare, query with JSONPath, and sort keys — all client-side, no data leaves your browser."
  toolName="JSON Formatter & Validator"
>
  <StructuredData 
    type="SoftwareApplication"
    data={{
      name: "JSON Formatter & Validator",
      applicationCategory: "DeveloperApplication",
      operatingSystem: "Any",
      description: "Online developer utility to format, validate, compare, and query JSON payloads. Highly secure and runs completely client-side in the browser.",
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD"
      }
    }}
  />

  <StructuredData 
    type="FAQPage"
    data={{
      mainEntity: [
        {
          "@type": "Question",
          "name": "Is this online JSON formatter safe to use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Unlike other tools that send your payloads to external servers, this formatter works 100% client-side. Your data remains safe and private within your local browser context."
          }
        },
        {
          "@type": "Question",
          "name": "Can I query JSON payloads using JSONPath?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, enter any valid JSONPath expression (e.g., $.store.book[*].author) in the query bar at the top of the editor and press query to extract specific nodes."
          }
        },
        {
          "@type": "Question",
          "name": "How do I compare two JSON objects?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Click the Compare tab to open the side-by-side Diff Editor. Paste your original JSON on the left and the modified JSON on the right to visually inspect differences."
          }
        }
      ]
    }}
  />
  
  <JsonFormatter client:only="react" />

  <section class="jf-docs-section">
    <details class="jf-docs-details" id="formatter-guide">
      <summary class="jf-docs-summary">
        <div class="jf-docs-summary-left">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
          </svg>
          <span class="jf-docs-summary-title">JSON Formatter & Diff Guide</span>
          <span class="jf-docs-summary-hint">Keyboard shortcuts, JSONPath tips & offline privacy</span>
        </div>
        <span class="jf-docs-summary-cta">View Guide & FAQs ↓</span>
      </summary>

      <article class="jf-seo-article">
        <h2>Online JSON Formatter, Validator & Diff Checker</h2>
        <p>
          Format, validate, query, and compare your JSON payloads in a secure, high-performance environment. 
          Designed for developers who want a familiar, VS Code-like coding experience directly in their web browser.
        </p>
        
        <div class="jf-seo-grid">
          <div class="jf-seo-card">
            <h3>⚡ High Performance Formatter</h3>
            <p>Format nested JSON payloads instantly. Clean formatting helps you read, debug, and inspect API responses quickly.</p>
          </div>
          <div class="jf-seo-card">
            <h3>🔍 JSONPath Querying</h3>
            <p>Filter and extract values from complex JSON payloads using powerful JSONPath expressions without leaving the tool.</p>
          </div>
          <div class="jf-seo-card">
            <h3>⚖️ Diff Checker & Compare</h3>
            <p>Compare two JSON objects side-by-side to highlight additions, modifications, and deletions. Spot structural differences in seconds.</p>
          </div>
          <div class="jf-seo-card">
            <h3>🔒 100% Client-Side & Secure</h3>
            <p>Your data never leaves your browser. All formatting, sorting, and validation occur completely locally in JavaScript.</p>
          </div>
        </div>

        <h2>How to Format and Validate JSON Online</h2>
        <ol>
          <li>Paste your raw JSON text directly into the VS Code-style editor.</li>
          <li>If there are any syntax errors, the built-in validator will underline them in red and display details in the blue status bar.</li>
          <li>Click <strong>Beautify</strong> (or press <code>Shift + Alt + F</code>) to format the code automatically, or click <strong>Minify</strong> to condense the payload.</li>
          <li>Use the <strong>Sort Keys</strong> action to sort JSON keys alphabetically for clean structure.</li>
        </ol>

        <h2>Frequently Asked Questions</h2>
        <dl class="jf-seo-faq">
          <dt>Is this online JSON formatter safe to use?</dt>
          <dd>Yes. Unlike other tools that send your payloads to external servers, this formatter works 100% client-side. Your data remains safe and private within your local browser context.</dd>
          
          <dt>Can I query JSON payloads using JSONPath?</dt>
          <dd>Yes, enter any valid JSONPath expression (e.g., <code>$.store.book[*].author</code>) in the query bar at the top of the editor and press query to extract specific nodes.</dd>
          
          <dt>How do I compare two JSON objects?</dt>
          <dd>Click the <strong>Compare</strong> tab to open the side-by-side Diff Editor. Paste your original JSON on the left and the modified JSON on the right to visually inspect differences.</dd>
        </dl>
      </article>
    </details>
  </section>
</ToolLayout>

<style>
  .jf-docs-section {
    width: 100%;
    background: var(--surface-raised);
    border-top: 1px solid var(--border-subtle);
    flex-shrink: 0;
  }

  .jf-docs-details {
    max-width: 900px;
    margin: 0 auto;
    padding: var(--space-2) var(--space-4);
  }

  .jf-docs-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    user-select: none;
    padding: var(--space-2) 0;
    gap: var(--space-3);
    list-style: none;
  }

  .jf-docs-summary::-webkit-details-marker {
    display: none;
  }

  .jf-docs-summary-left {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-primary);
    font-size: var(--text-small);
    font-weight: 600;
  }

  .jf-docs-summary-title {
    color: var(--text-primary);
  }

  .jf-docs-summary-hint {
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-weight: 400;
  }

  @media (max-width: 640px) {
    .jf-docs-summary-hint {
      display: none;
    }
  }

  .jf-docs-summary-cta {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--accent-default);
    padding: 3px 8px;
    background: var(--surface-sunken);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }

  .jf-seo-article {
    padding: var(--space-4) 0 var(--space-12);
    color: var(--text-secondary);
    line-height: var(--leading-normal);
  }

  .jf-seo-article h2 {
    color: var(--text-primary);
    font-size: var(--text-h2);
    margin-top: 32px;
    margin-bottom: var(--space-4);
    font-weight: 700;
  }

  .jf-seo-article p {
    margin-bottom: var(--space-6);
    font-size: var(--text-body);
  }

  .jf-seo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-4);
    margin: var(--space-6) 0;
  }

  .jf-seo-card {
    background: var(--surface-sunken);
    border: 1px solid var(--border-subtle);
    padding: var(--space-5);
    border-radius: var(--radius-md);
  }

  .jf-seo-card h3 {
    font-size: var(--text-ui);
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .jf-seo-card p {
    font-size: var(--text-small);
    margin-bottom: 0;
    color: var(--text-muted);
  }

  .jf-seo-article ol {
    margin-left: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .jf-seo-article li {
    margin-bottom: var(--space-2);
    color: var(--text-secondary);
  }

  .jf-seo-faq dt {
    font-weight: 600;
    color: var(--text-primary);
    margin-top: var(--space-4);
    margin-bottom: var(--space-1);
    font-size: var(--text-lead);
  }

  .jf-seo-faq dd {
    margin-left: 0;
    margin-bottom: var(--space-6);
    color: var(--text-muted);
  }
</style>
